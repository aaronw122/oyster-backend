  "transform": "(sources, inputs) => {\n  const feed = sources.citibike;\n  const rows = inputs.stations\n    .map((s) => ({ ...s, live: feed.stations[s.id] }))\n    .filter((r) => r.live && r.live.isReturning);\n  const pick = rows.find((r) => r.live.docksAvailable >= inputs.threshold);\n  const items = rows.map((r) => ({ label: r.live.name, value: r.live.docksAvailable + \" docks\" }));\n  if (!pick) {\n    return { value: \"No docks\", subtitle: \"None nearby with \" + inputs.threshold + \"+ docks\", items };\n  }\n  return {\n    value: pick.label,\n    subtitle: pick.live.docksAvailable + \" docks · \" + pick.distanceMi + \" mi\",\n    items,\n  };\n}",
