# HTTP port for Bun.serve (default 8787).
PORT=8787
# SQLite database file (default data/oyster.db; parent directory is created).
DB_PATH=data/oyster.db
# Public origin of this server, used to build OAuth callback URLs (default http://localhost:$PORT).
PUBLIC_BASE_URL=http://localhost:8787
# OpenRouter API key for the agent (optional until the agent is used).
OPENROUTER_API_KEY=
# Required. HMAC secret for signed OAuth `state` values. Generate: openssl rand -base64 32
OAUTH_STATE_SECRET=
# Required. 32 random bytes, base64, used to encrypt stored OAuth tokens. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Transform time limit per run, in milliseconds (default 1000).
SANDBOX_TIMEOUT_MS=1000
# Twelve Data key for stock quotes in the "markets" built-in (free plan: 8 credits/min, 800/day). Stocks fail with a plain "not set up" error without it.
TWELVE_DATA_API_KEY=
# Optional CoinGecko Demo key for crypto prices (free: 100 calls/min). Keyless works but shares a small per-IP pool that CoinGecko may block.
COINGECKO_API_KEY=

# OAuth providers (pre-registered, read-only scopes). Each provider is enabled only when BOTH
# its client id and secret are set. Register the redirect URI $PUBLIC_BASE_URL/oauth/<id>/callback
# with the provider, e.g. http://localhost:8787/oauth/github/callback.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_SPOTIFY_CLIENT_ID=
OAUTH_SPOTIFY_CLIENT_SECRET=
OAUTH_STRAVA_CLIENT_ID=
OAUTH_STRAVA_CLIENT_SECRET=
